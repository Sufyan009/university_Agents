# Copy to .env and fill in. Points at the SEPARATE university database.
APP_NAME=University Agent API
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Separate database — NOT the restaurant DB
DATABASE_URL=postgresql+asyncpg://postgres:Pakistan%4012345@postgres:5432/Universities_Voice_Agent

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Shared secret the LiveKit agent uses to post call-tracking events
AGENT_INTERNAL_API_KEY=set-a-shared-secret-here

# Used only for the special-instruction safety check (optional)
OPENAI_API_KEY=

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
