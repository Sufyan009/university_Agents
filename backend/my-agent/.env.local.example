# Copy to .env.local and fill in.

# Same SEPARATE university database the API uses — the agent reads it directly.
DATABASE_URL=postgresql+asyncpg://postgres:Pakistan%4012345@postgres:5432/Universities_Voice_Agent

# LiveKit
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI Realtime (LLM/STT/TTS) + Cartesia (optional TTS)
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Fallback phone if SIP metadata has no called number (maps to a seeded university)
UNIVERSITY_PHONE=+447570285155

# Call tracking → backend API
API_URL=http://localhost:8000
AGENT_INTERNAL_API_KEY=set-the-same-shared-secret-as-the-api
